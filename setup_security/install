#!/bin/bash
#
# Basic security hardening for Ubuntu/Debian build servers.
#
# - Unattended security upgrades (non-interactive)
# - Persistent iptables allowing only private inbound CIDRs
# - /dev/shm hardened in fstab
# - SSH root login disabled via sshd drop-in
#
# Safe to re-run (idempotent). See setup_security/README.md.
#

set -euo pipefail
IFS=$'\n\t'

SCRPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORIG_DIR="$(pwd)"

usage() {
    cat <<EOF
Usage: sudo ${SCRPT_DIR}/install [OPTIONS]

Options:
  --dry-run           Print actions without applying changes
  --force             Skip stamp-file notice on re-run
  --skip-firewall     Skip iptables setup
  --skip-unattended   Skip unattended-upgrades setup
  --skip-fstab        Skip /dev/shm fstab hardening
  --skip-sshd         Skip SSH hardening
  --skip-reboot       Do not prompt for reboot
  -h, --help          Show this help

Environment overrides (see config.defaults.sh):
  SECURITY_ALLOWED_CIDRS, SECURITY_IPV6_POLICY, SECURITY_UNATTENDED_EMAIL
EOF
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) DRY_RUN=1 ;;
            --force) FORCE=1 ;;
            --skip-firewall) SKIP_FIREWALL=1 ;;
            --skip-unattended) SKIP_UNATTENDED=1 ;;
            --skip-fstab) SKIP_FSTAB=1 ;;
            --skip-sshd) SKIP_SSHD=1 ;;
            --skip-reboot) SKIP_REBOOT_PROMPT=1 ;;
            -h|--help) usage; exit 0 ;;
            *) die "Unknown option: $1 (try --help)" ;;
        esac
        shift
    done
}

source_libs() {
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/preflight.sh"
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/unattended.sh"
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/firewall.sh"
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/fstab.sh"
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/sshd.sh"
}

main() {
    local yesno=""

    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/config.defaults.sh"
    # shellcheck disable=SC1091
    source "${SCRPT_DIR}/lib/common.sh"
    parse_args "$@"
    source_libs
    init_allowed_cidrs
    setup_logging

    check_for_root
    require_debian_like
    preflight_ssh_access
    check_existing_stamp
    print_plan

    get_user_input "Continue? [Y|n]: " "y" 15 yesno "Timed out. Exiting."
    [[ ${yesno} == "y" ]] || die "Aborted; no changes made."

    setup_auto_update
    setup_iptables
    setup_fstab
    setup_sshd
    write_stamp

    if [[ ${REBOOT_REQUIRED} -eq 1 && ${SKIP_REBOOT_PROMPT} -eq 0 ]]; then
        yesno=""
        get_user_input "A reboot is recommended. Reboot now? [Y|n]: " "y" 15 yesno \
            "Timed out. Please reboot when convenient."
        if [[ ${yesno} == "y" && ${DRY_RUN} -eq 0 ]]; then
            reboot
        else
            log "Please reboot when convenient."
        fi
    fi

    log "Done."
    cd "${ORIG_DIR}" >/dev/null || true
}

main "$@"
